{
  "name": "planttracer-webapp",
  "private": true,
  "dependencies": {
    "mp4box": "^2.4.1"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@html-eslint/eslint-plugin": "^0.65.0",
    "@html-eslint/parser": "^0.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "babel-jest": "^30.4.1",
    "babel-plugin-istanbul": "^8.0.0",
    "baseline-browser-mapping": "^2.11.19",
    "eslint": "^10.9.1",
    "eslint-formatter-friendly": "^7.0.0",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "jest-canvas-mock": "^2.5.8",
    "jest-environment-jsdom": "^30.4.1",
    "jest-fail-on-console": "^3.3.4",
    "jest-fetch-mock": "^4.2.0",
    "regenerator-runtime": "^0.14.1"
  },
  "scripts": {
    "test-debug": "node --experimental-vm-modules --trace-warnings --unhandled-rejections=warn-with-error-code node_modules/jest/bin/jest.js --maxWorkers 1 --verbose --expand --debug --no-cache",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --collectCoverage --"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/jstests/setupTests.js",
      "jest-canvas-mock"
    ],
    "moduleDirectories": [
      "node_modules",
      "src/app/static"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.venv",
      "<rootDir>/lambda-resize/.venv",
      "<rootDir>/.tmp/"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/.tmp/"
    ],
    "coveragePathIgnorePatterns": [
      "<rootDir>/.tmp/"
    ],
    "testEnvironment": "jsdom",
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "json",
      "lcov",
      "text",
      "clover"
    ],
    "transform": {
      "^.+\\.m?jsx?$": "babel-jest"
    },
    "testMatch": [
      "**/?(*.)+(spec|test).(mjs|js)"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 68,
        "branches": 62,
        "functions": 62,
        "lines": 69
      }
    }
  }
}
